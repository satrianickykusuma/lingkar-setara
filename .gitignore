# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# order store written by the sign-language backend (customer data â€” never commit)
/.data/

# recorded sign media (large) — keep the folder, not the files
!/public/videos/isyarat/.gitkeep

# original HEVC recordings, kept out of public/ so they are not served
/video-sources/

# transcode report (regenerated by tools/transcode_sign_clips.py)
/public/videos/transcode-report.json

# vendored python helpers (segno, opencv) — regenerated by tools/vendor_*.py
/.tools/

# build artifacts produced by 
etlify build (local deploy output)
/.netlify/

# vercel
.vercel
